rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Content: public read, no client writes (seeded with scripts/seed.js)
    match /{coll}/{id} {
      allow read: if coll in ['topics','lessons','questions','labs','challenges','sims','gameItems'];
      allow write: if false;
    }

    // User doc: signed-in users can read (leaderboard); writes only via /api/progress
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;

      match /topics/{tag} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /quizAttempts/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /rateLimits/{id} { allow read, write: if false; }
  }
}
