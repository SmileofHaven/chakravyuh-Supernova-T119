    "challenges": [
     {
      "id": "led-blink",
      "tag": "microcontrollers",
      "title": "Blink the LED",
      "language": "arduino-c",
      "difficulty": "easy",
      "xp": 50,
      "grader": "pin-trace",
      "statement": "An LED is connected to pin 13. Make it blink: ON for 500 ms, then OFF for 500 ms, repeating forever.",
      "starter": "void setup() {\n  // TODO: configure pin 13 as an output\n}\n\nvoid loop() {\n  // TODO: LED on, wait 500 ms, LED off, wait 500 ms\n}\n",
      "tests": [
       {
        "id": "1",
        "text": "Pin 13 is set to OUTPUT after setup()",
        "check": "pinModeOutput",
        "pin": 13
       },
       {
        "id": "2",
        "text": "The first loop turns the pin HIGH",
        "check": "firstHigh"
       },
       {
        "id": "3",
        "text": "HIGH lasts 500 ms (+/- 10 ms)",
        "check": "highMs",
        "ms": 500,
        "tol": 10
       },
       {
        "id": "4",
        "text": "LOW lasts 500 ms (+/- 10 ms)",
        "check": "lowMs",
        "ms": 500,
        "tol": 10
       },
       {
        "id": "5",
        "text": "The cycle repeats at least 3 times",
        "check": "cycles",
        "min": 3
       }
      ],
      "hints": [
       "A pin must be told whether it is an input or an output. Where should you do that once?",
       "Use pinMode() in setup(); use digitalWrite() and delay() in loop().",
       "pinMode(13, OUTPUT); then digitalWrite(13, HIGH); delay(500);"
      ],
      "solution": "void setup() { pinMode(13, OUTPUT); }\nvoid loop() {\n  digitalWrite(13, HIGH); delay(500);\n  digitalWrite(13, LOW); delay(500);\n}",
      "stretch": "Read an LDR with analogRead() and turn the LED on when the reading passes a threshold.",
      "lessonRef": "digital-electronics-01"
     }
